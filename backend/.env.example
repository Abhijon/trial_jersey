# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://abhijonrupai2003_db_user:o8v1QUp7OfQLmp8v@cluster0.mstafzw.mongodb.net/

# Long, random secret used to sign JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_gdjkgbasjkfgksdbfksdhkfgsdkvksdhvkhsdgkvksdgjksdvjsdvdmsgsjbvjsgvdmgsjvbwjgdsjgvsjbvwjvdmg

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# The origin your Next.js frontend runs on, for CORS
CLIENT_ORIGIN=http://localhost:3000

# AWS S3 Storage Credentials & Config
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=trail-jerseys-bucket

AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_sendgrid_from_email@example.com

# Static OTP Configuration (Bypass SendGrid API for testing/development)
USE_STATIC_OTP=true
STATIC_OTP=1234

# CloudAMQP / RabbitMQ Connection String (100% Free Plan available at cloudamqp.com)
# Example CloudAMQP URL: amqps://username:password@lemon.rmq.cloudamqp.com/vhost
RABBITMQ_URL=amqps://your_user:your_password@lemon.rmq.cloudamqp.com/vhost
# RabbitMQ Queue Retry & Dead Letter Queue (DLQ) Configuration
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000

# Razorpay Credentials (Test Mode Keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET





